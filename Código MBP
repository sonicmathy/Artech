<!DOCTYPE html> 
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ArtTech Market MVP</title>

<style>
body{
    font-family: Arial, sans-serif;
    background:#f4f4ff;
    text-align:center;
    margin:0;
}

header{
    background:#7b2cff;
    color:white;
    padding:20px;
}

.card{
    background:white;
    width:250px;
    margin:20px auto;
    padding:15px;
    border-radius:10px;
    box-shadow:0 0 10px gray;
}

button{
    background:#7b2cff;
    color:white;
    border:none;
    padding:10px;
    border-radius:5px;
    cursor:pointer;
}

input{
    padding:10px;
    width:250px;
}
</style>
</head>

<body>

<header>
    <h1>🎨 ArtTech Market</h1>
    <p>Tu arte, tu talento, tu negocio digital</p>
</header>

<h2>Obras Destacadas</h2>

<div class="card">
    <h3>Paisaje Digital</h3>
    <p>Autor: María López</p>
    <button>Comprar</button>
</div>

<div class="card">
    <h3>Arte Futurista</h3>
    <p>Autor: Juan Pérez</p>
    <button>Comprar</button>
</div>

<h2>Publicar una Obra</h2>

<input type="text" id="obra" placeholder="Nombre de la obra">
<button onclick="publicar()">Publicar</button>

<ul id="lista"></ul>

<script>
function publicar(){

    let obra = document.getElementById("obra").value;

    if(obra === ""){
        alert("Escribe el nombre de una obra");
        return;
    }

    let item = document.createElement("li");
    item.textContent = "🎨 " + obra;

    document.getElementById("lista").appendChild(item);

    document.getElementById("obra").value = "";
}
</script>

</body>
</html>
